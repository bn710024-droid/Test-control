+export type Spot = { lat: number; lng: number; accuracy: number | null };
+
+/**
+ * Position du téléphone, pour la livraison à domicile au Sénégal : le livreur s'y rend.
+ * `ask` : demande l'autorisation si elle n'a pas encore été donnée (à la confirmation du panier).
+ * Sans `ask`, ne dérange jamais le client : renvoie la position seulement s'il l'a déjà autorisée.
+ * Renvoie `null` si la localisation est refusée ou indisponible.
+ */
+export async function position(ask: boolean): Promise<Spot | null> {
+  try {
+    const permission = ask
+      ? await withTimeout(Location.requestForegroundPermissionsAsync(), 30000)
+      : await Location.getForegroundPermissionsAsync();
+    if (!permission.granted) return null;
+    // `maximumAge` : sur le web, sans cela, le navigateur rend indéfiniment la première position
+    // relevée ; le livreur irait à un endroit que le client a quitté. Ignoré sur iOS et Android,
+    // qui relèvent toujours une position fraîche.
+    const options = {
+      accuracy: ask ? Location.Accuracy.High : Location.Accuracy.Balanced,
+      maximumAge: 10000,
+    } as Location.LocationOptions;
+    const found = await withTimeout(Location.getCurrentPositionAsync(options), 20000);
+    return {
+      lat: found.coords.latitude,
+      lng: found.coords.longitude,
+      accuracy: found.coords.accuracy ?? null,
+    };
+  } catch {
+    return null;
+  }
+}
