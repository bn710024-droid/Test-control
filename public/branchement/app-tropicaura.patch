+import React, { useCallback, useRef, useState } from 'react';
+import { FlatList, ScrollView, StyleSheet, Text, View, ViewToken } from 'react-native';
+import { Image } from 'expo-image';
+import Ionicons from '@expo/vector-icons/Ionicons';
+import { KeepsOwnSwipes, PAGE_SCROLL } from './PageSwipe';
+import { Comments } from './Reels';
+import { Sheet } from './Sheet';
+import { TAB_BAR_SPACE } from './TabBar';
+import { Pressable } from './Tap';
+import { formatDay } from '../lib/format';
+import { tick } from '../lib/haptics';
+import type { PhotoPost } from '../lib/posts';
+import { useStore } from '../lib/store';
+import { C, F, PAD, R } from '../lib/theme';
+import { useFrame } from '../lib/useFrame';
+
+const LEAF = require('../assets/decor/leaf.webp');
+
+/**
+ * Une publication photo de l'équipe : ses photos défilent de côté, la description reste dessous.
+ * On peut l'aimer et la commenter. Rien n'y mène à un produit : les liens vers les produits sont
+ * réservés aux annonces du bandeau d'accueil.
+ */
+function Post({
+  post,
+  width,
+  liked,
+  commentCount,
+  onLike,
+  onComments,
+}: {
+  post: PhotoPost;
+  width: number;
+  liked: boolean;
+  commentCount: number;
+  onLike: (id: string) => void;
+  onComments: (id: string) => void;
+}) {
+  const [index, setIndex] = useState(0);
+  const count = post.images.length;
+  const first = post.images[0];
+  // La première photo donne son format à toute la publication, entre 4:5 et 1,91:1.
+  const ratio =
+    first.width > 0 && first.height > 0
+      ? Math.max(0.8, Math.min(1.91, first.width / first.height))
+      : 1;
+  const height = Math.round(width / ratio);
+
+  return (
+    <View style={styles.post}>
+      <View style={styles.head}>
+        <View style={styles.avatar}>
+          <Image source={LEAF} style={styles.avatarLeaf} contentFit="contain" accessible={false} />
+        </View>
+        <View style={{ flex: 1 }}>
+          <Text style={styles.author} numberOfLines={1}>
+            Tropicaura
+          </Text>
+          {!!post.publishedAt && <Text style={styles.date}>{formatDay(post.publishedAt)}</Text>}
+        </View>
+      </View>
+
+      {/* Les photos gardent leur glissement horizontal : il ne change pas de page. */}
+      <KeepsOwnSwipes style={{ width, height, backgroundColor: '#000000' }}>
+        <ScrollView
+          horizontal
+          pagingEnabled
+          showsHorizontalScrollIndicator={false}
+          scrollEventThrottle={16}
+          decelerationRate="fast"
+          onScroll={(e) => setIndex(Math.round(e.nativeEvent.contentOffset.x / width))}
+          accessibilityLabel={
+            count > 1 ? `${count} photos. Glissez de côté pour les voir.` : undefined
+          }
+        >
+          {post.images.map((img, i) => (
+            <Image
+              key={img.url}
+              source={{ uri: img.url }}
+              style={{ width, height }}
+              contentFit="cover"
+              transition={200}
+              priority={i === 0 ? 'high' : 'normal'}
+              accessibilityLabel={`Photo ${i + 1} sur ${count}`}
+            />
+          ))}
+        </ScrollView>
